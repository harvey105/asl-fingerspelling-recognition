<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.6">
  <diagram name="Homograph-Comparison">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="380" math="1" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;&quot;&gt;&lt;b style=&quot;font-size:16px;color:#0f172a;&quot;&gt;Category A: Why '6' and 'W' Confuse a 2D Camera&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;Two distinct 3D hand shapes flatten into nearly identical 2D outlines from the front view&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="650" height="40" as="geometry" />
        </mxCell>

        <!-- Metric Badge Top Right -->
        <mxCell id="badge1" value="&lt;span style=&quot;font-size:10px;color:#b91c1c;&quot;&gt;&lt;b&gt;Error share in Model 3:&lt;/b&gt; 215 / 586 (36.7%)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="30" width="220" height="26" as="geometry" />
        </mxCell>

        <!-- Card Left: Sign '6' -->
        <mxCell id="c_left" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_left_header" value="&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;Sign '6' (Number)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="98" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c_left_desc" value="&lt;div style=&quot;font-size:11px;color:#334155;line-height:1.6;&quot;&gt;&lt;b&gt;Hand shape in 3D:&lt;/b&gt;&lt;br&gt;&amp;bull; Index, middle, and ring fingers extend straight up&lt;br&gt;&amp;bull; Thumb tip touches the tip of the pinky finger&lt;br&gt;&amp;bull; Forms a round pinch ring against the palm&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="132" width="240" height="145" as="geometry" />
        </mxCell>

        <!-- Card Right: Sign 'W' -->
        <mxCell id="c_right" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="85" width="270" height="205" as="geometry" />
        </mxCell>
        <mxCell id="c_right_header" value="&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;Sign 'W' (Letter)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="740" y="98" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c_right_desc" value="&lt;div style=&quot;font-size:11px;color:#334155;line-height:1.6;&quot;&gt;&lt;b&gt;Hand shape in 3D:&lt;/b&gt;&lt;br&gt;&amp;bull; Index, middle, and ring fingers extend straight up&lt;br&gt;&amp;bull; Thumb folds across and holds down the pinky nail&lt;br&gt;&amp;bull; Pinky rests flat across the front of the palm&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="745" y="132" width="240" height="145" as="geometry" />
        </mxCell>

        <!-- Center Block: 2D Front View -->
        <mxCell id="center_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="370" y="85" width="300" height="205" as="geometry" />
        </mxCell>
        <mxCell id="center_header" value="&lt;b style=&quot;font-size:12px;color:#1d4ed8;&quot;&gt;Front View 2D Camera&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;Looking directly at the palm&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="375" y="98" width="290" height="32" as="geometry" />
        </mxCell>
        <mxCell id="center_inner" value="&lt;div style=&quot;font-size:11px;color:#0f172a;line-height:1.6;background:#ffffff;padding:10px;border:1px solid #cbd5e1;&quot;&gt;&lt;b style=&quot;color:#b91c1c;&quot;&gt;Matching 2D Outline&lt;/b&gt;&lt;br&gt;&amp;bull; Both show three extended vertical fingers&lt;br&gt;&amp;bull; The thumb-pinky contact is hidden behind the palm&lt;br&gt;&amp;bull; Single-frame 2D photos lack depth cues&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="385" y="140" width="270" height="85" as="geometry" />
        </mxCell>
        <mxCell id="center_footer" value="&lt;b style=&quot;font-size:10.5px;color:#b91c1c;&quot;&gt;Model 3 mistakes '6' as 'W' in 182 / 200 test cases&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="375" y="245" width="290" height="25" as="geometry" />
        </mxCell>

        <!-- Connecting Arrows -->
        <mxCell id="arr_left" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#1d4ed8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_left" target="center_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_right" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#1d4ed8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_right" target="center_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Bottom Summary Strip -->
        <mxCell id="summary" value="&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;&lt;b&gt;Takeaway:&lt;/b&gt; Without depth information (RGB-D) or a side angle, the difference between '6' and 'W' is physically hidden from a front-facing 2D camera.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#e2e8f0;strokeWidth=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="315" width="960" height="32" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
