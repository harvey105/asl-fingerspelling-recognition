        <mxCell id="title" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;&quot;&gt;&lt;b style=&quot;font-size:15px;color:#0f172a;&quot;&gt;Effective Receptive Field Coverage Across Architectures&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;Spatial Receptive Field Span Prior to Global Average Pooling Relative to 224×224 Input Window (1 px = 1.25 pt scale)&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
