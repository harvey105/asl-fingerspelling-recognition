        <mxCell id="src" value="&lt;b style=&quot;font-size:13px;color:#0f172a;&quot;&gt;ASL-HG Dataset (36,000 Captures)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;10 Signers (P1–P10) · 36 Classes · 100 Captures per Signer per Class&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;" vertex="1" parent="1">
