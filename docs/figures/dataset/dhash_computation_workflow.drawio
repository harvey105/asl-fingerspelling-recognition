        <!-- Step 1 -->
        <mxCell id="s1" value="&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;300×300 Image&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#64748b;&quot;&gt;RGB frame&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1">
