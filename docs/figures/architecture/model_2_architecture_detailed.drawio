        <!-- ZOOM CALLOUT PANEL: RESIDUAL BLOCK ANATOMY -->
        <mxCell id="zoom_panel" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="1535" height="220" as="geometry" />
        </mxCell>
        <mxCell id="zoom_title" value="&lt;b style=&quot;font-size:12px;color:#6b21a8;&quot;&gt;RESIDUAL MECHANISM: RESIDUAL BLOCK INTERNAL ANATOMY &amp;amp; SHORTCUT TOPOLOGY&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="390" width="800" height="20" as="geometry" />
        </mxCell>

        <!-- Residual Zoom Diagram -->
        <!-- In: x -->
        <mxCell id="rx_in" value="&lt;b style=&quot;font-size:11px;color:#0f172a;&quot;&gt;\(x\)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748b;&quot;&gt;\(C_{\text{in}} \times H \times W\)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="105" height="50" as="geometry" />
        </mxCell>

        <!-- Main residual path: Conv1 -> BN -> ReLU -> Conv2 -> BN -->
        <mxCell id="r_c1" value="&lt;b style=&quot;font-size:10px;color:#0f172a;&quot;&gt;Conv2d 3×3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748b;&quot;&gt;stride=\(s\), pad=1&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="450" width="115" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_bn1" value="&lt;b style=&quot;font-size:10px;color:#0f172a;&quot;&gt;BatchNorm2d&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#2563eb;&quot;&gt;+ ReLU&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="115" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_c2" value="&lt;b style=&quot;font-size:10px;color:#0f172a;&quot;&gt;Conv2d 3×3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748b;&quot;&gt;stride=1, pad=1&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="450" width="115" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_bn2" value="&lt;b style=&quot;font-size:10px;color:#0f172a;&quot;&gt;BatchNorm2d&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748b;&quot;&gt;Affine Normalize&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="450" width="115" height="50" as="geometry" />
        </mxCell>

        <!-- Addition node: (+) -->
        <mxCell id="r_add" value="&lt;b style=&quot;font-size:16px;color:#7c3aed;&quot;&gt;+&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="840" y="455" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Final Activation -> Out -->
        <mxCell id="r_act" value="&lt;b style=&quot;font-size:10px;color:#0f172a;&quot;&gt;ReLU&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#64748b;&quot;&gt;Output Gate&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="450" width="85" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rx_out" value="&lt;b style=&quot;font-size:11px;color:#0f172a;&quot;&gt;\(y = \mathcal{F}(x) + x\)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#2563eb;&quot;&gt;\(C_{\text{out}} \times H&#39; \times W&#39;\)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="1045" y="450" width="125" height="50" as="geometry" />
        </mxCell>

        <!-- Main residual connectors -->
        <mxCell id="re1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#0f172a;" edge="1" parent="1" source="rx_in" target="r_c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#0f172a;" edge="1" parent="1" source="r_c1" target="r_bn1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#0f172a;" edge="1" parent="1" source="r_bn1" target="r_c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#0f172a;" edge="1" parent="1" source="r_c2" target="r_bn2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#0f172a;" edge="1" parent="1" source="r_bn2" target="r_add">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#0f172a;" edge="1" parent="1" source="r_add" target="r_act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.2;strokeColor=#0f172a;" edge="1" parent="1" source="r_act" target="rx_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Shortcut Connection (Overhead Arc) -->
        <mxCell id="r_sc_box" value="&lt;b style=&quot;font-size:9px;color:#7c3aed;&quot;&gt;Shortcut Path&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475569;&quot;&gt;Identity \(x\) if \(s=1\) and \(C_{\text{in}} = C_{\text{out}}\)&lt;br&gt;Conv 1×1 (\(s=2\)) + BN if downsampling&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a855f7;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="525" width="280" height="42" as="geometry" />
        </mxCell>
        <mxCell id="re_sc_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#a855f7;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rx_in" target="r_sc_box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="132" y="546" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="re_sc_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;strokeColor=#a855f7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_sc_box" target="r_add">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="546" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Right Side Mathematical & Explanatory Box -->
        <mxCell id="r_notes" value="&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;&lt;b style=&quot;font-size:11px;color:#0f172a;&quot;&gt;Residual Formulation &amp;amp; Optimization Properties:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;&amp;bull; &lt;b&gt;Mapping Function:&lt;/b&gt; \(y = \text{ReLU}(\mathcal{F}(x, \{W_i\}) + W_s x)\)&lt;br&gt;&amp;bull; &lt;b&gt;Gradient Propagation:&lt;/b&gt; \(\frac{\partial \mathcal{L}}{\partial x} = \frac{\partial \mathcal{L}}{\partial y} \cdot \left(\frac{\partial \mathcal{F}}{\partial x} + W_s\right)\), guaranteeing direct gradient flow back through deep stages.&lt;br&gt;&amp;bull; &lt;b&gt;Projection Parameterization:&lt;/b&gt; \(W_s\) operates as a linear projection (Conv \(1 \times 1\) with stride 2) when matching altered spatial resolution and channel dimensionality.&lt;br&gt;&amp;bull; &lt;b&gt;Regularization:&lt;/b&gt; Dual dropout (\(p=0.3\)) integrated across classifier projection layers.&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1195" y="420" width="375" height="155" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption" value="Figure 2. Architectural blueprint of Model 2 (Residual Deep CNN). The stem performs initial 3×3 spatial convolution and downsampling to 32 channels. Four modular residual stages (depth=2 each) progressively scale capacity to 256 channels via projection shortcuts (stride=2) and identity skip connections. The lower panel illustrates the internal residual anatomy mitigating gradient decay." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor:#64748b;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="630" width="1535" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
