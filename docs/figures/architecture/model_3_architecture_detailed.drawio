        </mxCell>

        <!-- Left Box: Transfer Fine-Tuning Strategy -->
        <mxCell id="inf_strat" value="&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1e3a8a;&quot;&gt;Transfer Fine-Tuning Specification:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;&amp;bull; &lt;b&gt;Visual Prior:&lt;/b&gt; Pretrained on ImageNet-1k (1.28M natural images), providing low-level edge filters and mid-level geometric primitives.&lt;br&gt;&amp;bull; &lt;b&gt;Differential Learning Rates:&lt;/b&gt; Backbone fine-tuned at \(\eta_{\text{bb}} = 1.0 \times 10^{-4}\) to preserve generic visual features; convex linear head trained at \(\eta_{\text{head}} = 5.0 \times 10^{-4}\) (\(5\times\) ratio) for task specialization.&lt;br&gt;&amp;bull; &lt;b&gt;Optimization:&lt;/b&gt; AdamW optimizer with weight decay \(\lambda = 1 \times 10^{-4}\), Cosine Annealing learning rate schedule, and label smoothing \(\epsilon = 0.1\).&lt;br&gt;&amp;bull; &lt;b&gt;Convergence:&lt;/b&gt; Best validation performance reached at Epoch 10.&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="720" height="175" as="geometry" />
        </mxCell>

        <!-- Right Box: Empirical Error & Homograph Analysis -->
        <mxCell id="inf_bayes" value="&lt;div style=&quot;text-align:left;line-height:1.4;&quot;&gt;&lt;b style=&quot;font-size:12px;color:#0f172a;&quot;&gt;Empirical Error Distribution &amp;amp; Boundary Analysis:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;&amp;bull; &lt;b&gt;Test Generalization:&lt;/b&gt; 91.86% Top-1 Accuracy and 91.10% Macro-F1 across 7,200 unseen test samples (Signers P9 &amp;amp; P10).&lt;br&gt;&amp;bull; &lt;b&gt;Perfect Recognition:&lt;/b&gt; 24 of 36 distinct fingerspelling classes achieve 100.0% precision, recall, and F1 score.&lt;br&gt;&amp;bull; &lt;b&gt;Homograph Concentration:&lt;/b&gt; 91.5% of total errors (536 / 586 misclassifications) occur across 5 static visual pairs: \(6 \leftrightarrow W\) (311), \(1 \leftrightarrow Z\) (108), \(I \leftrightarrow J\) (100), \(N \leftrightarrow M\) (98), and \(R \leftrightarrow U\) (65).&lt;br&gt;&amp;bull; &lt;b&gt;Static Limit:&lt;/b&gt; Signs requiring dynamic gesture trajectories (\(J\) and \(Z\)) exhibit intrinsic single-frame projection ambiguity.&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="815" y="410" width="770" height="175" as="geometry" />
        </mxCell>

        <!-- Bottom Caption -->
        <mxCell id="caption" value="Figure 3. Architectural blueprint of Model 3 (Transfer Learning ResNet-18). The network couples an ImageNet-1k pretrained ResNet-18 vision backbone (11,176,512 parameters) with a regularized linear projection head (18,468 parameters, 11,194,980 total). Differential optimization enables transferring foundational visual representations while adapting to fingerspelling classification." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor:#64748b;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="630" width="1555" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
