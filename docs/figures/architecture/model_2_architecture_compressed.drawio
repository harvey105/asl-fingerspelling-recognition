        <mxCell id="t1" value="&lt;div style=&quot;font-family:Arial,Helvetica,sans-serif;&quot;&gt;&lt;b style=&quot;font-size:18px;color:#0f172a;&quot;&gt;Model 2: Residual Deep CNN — Compressed Pipeline Notation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b;&quot;&gt;Tensor Dimension Flow, Residual Stage Depths &amp;amp; Shortcuts &amp;bull; 2,870,084 Parameters &amp;bull; Deep Architecture&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
